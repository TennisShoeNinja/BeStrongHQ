# BeStrong Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Google OAuth (required for authentication)
# ---------------------------------------------------------------------------
# Get these from Google Cloud Console > APIs & Services > Credentials.
# One OAuth client handles both login and Google Drive access in the default
# configuration. This is the recommended setup for self-hosted installs.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Optional: split login and Drive into separate OAuth clients ---
# Mixing the Drive scope with basic identity scopes on a single consent
# screen causes Google to treat the whole app as sensitive, which matters
# if you want to publish the consent screen to production users. Splitting
# lets the login flow use only non-restricted scopes (quick, free review)
# while Drive access stays on its own client. Leave these blank for the
# unified setup above.
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# Where Google redirects after login (must match your Google Cloud config)
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Base URL of the Next.js frontend (for post-login redirects)
FRONTEND_URL=http://localhost:3000

# While the Google OAuth consent screen is in Testing mode, Google expires
# refresh tokens after 7 days. We show a proactive "renew" banner during
# that window. Flip to false once the consent screen is Published.
GOOGLE_OAUTH_TESTING_MODE=true

# ---------------------------------------------------------------------------
# Database (optional, has sensible defaults)
# ---------------------------------------------------------------------------
# Path to the SQLite database file.
# Default: ~/.bestrong/bestrong.db
# BESTRONG_DB_PATH=/path/to/bestrong.db
