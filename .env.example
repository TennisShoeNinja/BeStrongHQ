# BeStrong Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Google OAuth — for Google Drive and Google Calendar features
# ---------------------------------------------------------------------------
# Local mode does not require user login; the local DB is the access
# boundary. So no Login OAuth client is needed for self-hosted installs.
#
# Drive and Calendar features DO need their own OAuth client, since they
# read the operator's Google account on their behalf. Drive and Calendar
# share one client (same Google Cloud project, both APIs enabled).
#
# Skip this section entirely if you don't plan to use Drive sync or
# Calendar features. To enable them:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID, Application type: Web application
#   3. In APIs & Services > Library, enable both
#      "Google Drive API" and "Google Calendar API" on the same project
#   4. Add this Authorized redirect URI to the OAuth client:
#        http://127.0.0.1:8080/api/gdrive/auth/callback
#      Use 127.0.0.1, not localhost: Google treats them as different
#      origins, and many setups only register the 127.0.0.1 form.
#   5. Paste the Client ID and Client Secret below.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# While the Drive/Calendar consent screen is in Testing mode, Google
# expires refresh tokens after 7 days. We show a proactive "renew"
# banner during that window. Flip to false once the consent screen is
# Published.
GOOGLE_OAUTH_TESTING_MODE=true

# ---------------------------------------------------------------------------
# Database (optional, has sensible defaults)
# ---------------------------------------------------------------------------
# Path to the SQLite database file.
# Default: ~/.bestrong/bestrong.db
# BESTRONG_DB_PATH=/path/to/bestrong.db
